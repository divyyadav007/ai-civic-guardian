# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civic_guardian
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civic_guardian
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/civic_guardian

# Media Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=civic-guardian

# JWT Security
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_civic_guardian_32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / ML Providers & Config
CLASSIFICATION_PROVIDER=mobilenet
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
STT_PROVIDER=whisper
DEV_OTP_CODE=123456
